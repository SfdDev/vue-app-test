{"file":"parallax-container-BYPNbLq2.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AAMA,SAAK,eAAe,aAAa;AAErB,QAAwB,IAAI;;;;;;;;;;;;;;;","names":[],"sources":["../../../../src/pages/parallax-container.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { onMounted, ref } from 'vue';\nimport { gsap } from 'gsap';\nimport { ScrollTrigger } from 'gsap/ScrollTrigger';\nimport Hero from '@/components/hero.vue';\n\ngsap.registerPlugin(ScrollTrigger);\n\nconst box = ref<HTMLElement | null>(null);\n\nonMounted(() => {\n  if (!box.value) return;\n  gsap.from(box.value, {\n    scrollTrigger: {\n      trigger: box.value,\n      start: 'top 80%',\n      end: 'top 30%',\n      toggleActions: 'play none none reverse',\n    },\n    y: 100,\n    opacity: 0,\n    duration: 1,\n    ease: 'power2.out',\n  });\n});\n</script>\n\n<template>\n  <Hero />\n  <section class=\"parallax-demo\">\n    <div ref=\"box\" class=\"box\">\n      ScrollTrigger работает\n    </div>\n  </section>\n  <section class=\"parallax-container\" />\n  <section class=\"scroll-spacer\" />\n</template>\n\n<style scoped lang=\"scss\">\n.parallax-demo {\n  height: 150vh;\n  background: #f3f3f3;\n}\n</style>\n"],"version":3}