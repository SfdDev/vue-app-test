{"file":"_id_-DgvmkAzG.js","mappings":";;;;;;;;;;;;;;;;;;;;AAMA,UAAM,gBAAgB,iBAAA;AACtB,UAAM,QAAQ,SAAA;AACC,cAAA;AAEf,UAAM,UAAU,IAAI,IAAI;AAEN,aAAS,MAAM,OAAO,MAAM,OAAO,EAAE,CAAC;AACxD,UAAM,UAAU,SAAS,MAAM,cAAc,OAAO;AAEpD,UAAM,eAAe,SAAS,MAAM;AAClC,UAAI,CAAC,QAAQ,SAAS,CAAC,cAAc,SAAS,OAAQ,QAAO;AAC7D,aAAO,cAAc,SAAS,UAAU,CAAC,MAAW,EAAE,OAAO,QAAQ,OAAO,EAAE;AAAA,IAChF,CAAC;AAED,UAAM,gBAAgB,SAAS,MAAM;AACnC,UAAI,aAAa,UAAU,GAAI,QAAO;AACtC,aAAO,aAAa,QAAQ,KAAK,cAAc,WAAW,cAAc;AAAA,IAC1E,CAAC;AAED,UAAM,YAAY,SAAS,MAAM;AAC/B,UAAI,aAAa,UAAU,GAAI,QAAO;AACtC,aAAO,aAAa,QAAQ,cAAc,SAAS,SAAS,KAAK,cAAc,WAAW,cAAc,cAAc,WAAW;AAAA,IACnI,CAAC;AAED,mBAAe,mBAAmB,IAAY;AAC5C,UAAI,CAAC,MAAM,OAAO,MAAM,EAAE,EAAG;AAC7B,YAAM,EAAE,oBAAoB,cAAc;AAE1C,YAAM,WAAW,MAAM,OAAyB,yBAAyB,EAAE,IAAI;AAAA,QAC7E,OAAO,EAAE,UAAU,gBAAA;AAAA,MAAgB,CACpC;AACD,YAAM,OAAO,SAAS;AACtB,oBAAc,cAAc,IAAI;AAEhC,YAAM,cAAc,aAAa,MAAM,eAAe;AACtD,YAAM,cAAc,gBAAgB,EAAE;AAAA,IACxC;AA8DA;AAAA,MACE,MAAM,MAAM,OAAO;AAAA,MACnB,OAAO,UAAU;AACf,YAAI,OAAO;AACT,kBAAQ,QAAQ;AAChB,gBAAM,mBAAmB,OAAO,KAAK,CAAC;AACtC,kBAAQ,QAAQ;AAAA,QAClB;AAAA,MACF;AAAA,IAAA;;;AAKS,YAAA,WAAAA,eAAAC,WAAA,EAAA,OAAM,aAAS,MAAA,CAAA,CAAA,0DAAA;AAET,UAAA,QAAA,UAAY,QAAA,OAAO;sNAInBC,eAAA,QAAA,MAAQ,KAAK,gFAGDA,eAAA,QAAA,MAAQ,WAAW,4DACZC,MAAA,UAAA,EAAW,QAAA,MAAQ,UAAU,CAAA;AAI7C,YAAA,QAAA,MAAQ,WAAS;uBACtBC,cAAA,OAAKD,MAAA,eAAA,EAAgB,QAAA,MAAQ,SAAS,CAAA,kBACtC,OAAK,QAAA,MAAQ,KAAK;;;;AAMgB,cAAA,yFAAA,QAAA,MAAQ,WAAO,EAAA,0DAAA;;UAIxC,IAAG;AAAA,UAAQ,OAAM;AAAA,QAAA;2BAA3B,CAEW,GAAAE,QAAAC,UAAA,aAAA;;;;;gCAFgC,mBAE3C;AAAA,cAAA;AAAA;;;;qLAagB,cAAA,KAAa,IAAA,cAAA,KACxBF,cAAA,kBAAgB,cAAA,KAAa,kGAQlB,UAAA,KAAS,IAAA,cAAA,KACpBA,cAAA,kBAAgB,UAAA,KAAS;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_unref","_ssrRenderAttr","_push","_parent"],"sources":["../../../../src/pages/blog/[id].vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { computed, onMounted, ref, watch } from 'vue';\nimport { useRoute, useRouter } from '#imports';\nimport { useArticlesStore } from '@/store/articles';\nimport { formatDate, getFullImageUrl } from '@/utils/common';\n\nconst articlesStore = useArticlesStore();\nconst route = useRoute();\nconst router = useRouter();\n\nconst loading = ref(true);\n\nconst currentId = computed(() => Number(route.params.id));\nconst article = computed(() => articlesStore.article);\n\nconst currentIndex = computed(() => {\n  if (!article.value || !articlesStore.articles.length) return -1;\n  return articlesStore.articles.findIndex((a: any) => a.id === article.value?.id);\n});\n\nconst canGoPrevious = computed(() => {\n  if (currentIndex.value === -1) return false;\n  return currentIndex.value > 0 || articlesStore.pagination.currentPage > 1;\n});\n\nconst canGoNext = computed(() => {\n  if (currentIndex.value === -1) return false;\n  return currentIndex.value < articlesStore.articles.length - 1 || articlesStore.pagination.currentPage < articlesStore.pagination.totalPages;\n});\n\nasync function loadPageForArticle(id: number) {\n  if (!id || Number.isNaN(id)) return;\n  const { articlesPerPage } = articlesStore.pagination;\n\n  const response = await $fetch<{ page: number }>(`/api/articles/page-of/${id}`, {\n    query: { per_page: articlesPerPage },\n  });\n  const page = response.page;\n  articlesStore.setOriginPage(page);\n\n  await articlesStore.loadArticles(page, articlesPerPage);\n  await articlesStore.loadArticleById(id);\n}\n\nasync function goToPrevious() {\n  if (!article.value?.id) return;\n\n  const { articles, pagination } = articlesStore;\n  const idx = articles.findIndex((a: any) => a.id === article.value?.id);\n\n  if (idx > 0) {\n    const prevArticle = articles[idx - 1];\n    await router.push(`/blog/${prevArticle.id}`);\n    return;\n  }\n\n  if (pagination.currentPage > 1) {\n    const prevPage = pagination.currentPage - 1;\n    await articlesStore.loadArticles(prevPage, pagination.articlesPerPage);\n    if (articlesStore.articles.length) {\n      const lastArticle = articlesStore.articles[articlesStore.articles.length - 1];\n      await articlesStore.loadArticleById(lastArticle.id);\n      await router.push(`/blog/${lastArticle.id}`);\n    }\n  }\n}\n\nasync function goToNext() {\n  if (!article.value?.id) return;\n\n  const { articles, pagination } = articlesStore;\n  const idx = articles.findIndex((a: any) => a.id === article.value?.id);\n\n  if (idx < articles.length - 1) {\n    const nextArticle = articles[idx + 1];\n    await router.push(`/blog/${nextArticle.id}`);\n    return;\n  }\n\n  if (pagination.currentPage < pagination.totalPages) {\n    const nextPage = pagination.currentPage + 1;\n    await articlesStore.loadArticles(nextPage, pagination.articlesPerPage);\n    if (articlesStore.articles.length) {\n      const firstArticle = articlesStore.articles[0];\n      await articlesStore.loadArticleById(firstArticle.id);\n      await router.push(`/blog/${firstArticle.id}`);\n    }\n  }\n}\n\nfunction goBack() {\n  const page = articlesStore.originPage ?? 1;\n  if (page === 1) {\n    router.push('/blog');\n  } else {\n    router.push(`/blog?page=${page}`);\n  }\n}\n\nonMounted(async () => {\n  await loadPageForArticle(currentId.value);\n  loading.value = false;\n});\n\nwatch(\n  () => route.params.id,\n  async (newId) => {\n    if (newId) {\n      loading.value = true;\n      await loadPageForArticle(Number(newId));\n      loading.value = false;\n    }\n  },\n);\n</script>\n\n<template>\n  <section class=\"article\">\n    <div class=\"container\">\n      <div v-if=\"article && !loading\" class=\"row justify-center\">\n        <div class=\"col-12 col-sm-8 col-md-7\">\n          <article class=\"card article__card\">\n            <h1 class=\"article__title\">\n              {{ article.title }}\n            </h1>\n            <div class=\"article__meta\">\n              <div>Автор: {{ article.author_name }}</div>\n              <div>Опубликовано: {{ formatDate(article.created_at) }}</div>\n            </div>\n\n            <img\n              v-if=\"article.image_url\"\n              :src=\"getFullImageUrl(article.image_url)\"\n              :alt=\"article.title\"\n              class=\"article-image\"\n              loading=\"lazy\"\n            >\n\n            <div class=\"article__body\">\n              <p class=\"article-content\" v-html=\"article.content\" />\n            </div>\n\n            <div class=\"article__actions\">\n              <NuxtLink to=\"/blog\" class=\"btn btn--link\">\n                ← Назад к блогу\n              </NuxtLink>\n              <button\n                class=\"btn\"\n                type=\"button\"\n                @click=\"goBack\"\n              >\n                Назад\n              </button>\n\n              <div class=\"article__nav\">\n                <button\n                  class=\"btn\"\n                  type=\"button\"\n                  :disabled=\"!canGoPrevious\"\n                  :aria-disabled=\"!canGoPrevious\"\n                  @click=\"goToPrevious\"\n                >\n                  Предыдущая\n                </button>\n                <button\n                  class=\"btn\"\n                  type=\"button\"\n                  :disabled=\"!canGoNext\"\n                  :aria-disabled=\"!canGoNext\"\n                  @click=\"goToNext\"\n                >\n                  Следующая\n                </button>\n              </div>\n            </div>\n          </article>\n        </div>\n      </div>\n\n      <div v-else class=\"article__loading\">\n        Загрузка...\n      </div>\n    </div>\n  </section>\n</template>\n\n<style scoped lang=\"scss\">\n.article {\n  &__card {\n    padding: 1.5rem;\n  }\n\n  &__title {\n    margin: 0 0 1rem;\n  }\n\n  &__meta {\n    margin-bottom: 1rem;\n    display: flex;\n    flex-direction: column;\n    gap: 0.35rem;\n  }\n\n  &__body {\n    padding: 0.25rem 0;\n  }\n\n  &__actions {\n    display: flex;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n    margin-top: 1.5rem;\n  }\n\n  &__nav {\n    display: flex;\n    justify-content: space-between;\n    gap: 0.75rem;\n  }\n\n  &__loading {\n    text-align: center;\n    padding: 3rem 0;\n  }\n}\n\n.article-content :deep(p) {\n  margin-bottom: 1rem;\n}\n\n.article-content :deep(img) {\n  max-width: 100%;\n  height: auto;\n}\n\n.article-image {\n  border-radius: 4px;\n  margin: 16px 0;\n}\n</style>\n\n"],"version":3}