# Database
# For host tools (psql / npm run seed:admin) use localhost + mapped port.
# docker compose overrides DB_HOST/DB_PORT for the app container.
DB_HOST=localhost
DB_PORT=5433
DB_USER=vueblog
DB_PASSWORD=vueblog
DB_NAME=vueblog

# App
APP_PORT=3020

# Auth
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Recaptcha
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
